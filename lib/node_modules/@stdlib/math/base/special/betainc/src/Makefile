# Makefile for building a C addon

# Variables
CC := gcc
CFLAGS := -std=c99 -Wall -Wextra -O2
INCLUDES := -I$(NODE_ROOT)/include/node -I../../../..
LDFLAGS := -shared -fPIC
TARGET := addon.node
SOURCES := addon.c main.c

# Default target
all: $(TARGET)

# Build the shared library
$(TARGET): $(SOURCES)
	$(CC) $(CFLAGS) $(INCLUDES) $(LDFLAGS) -o $(TARGET) $(SOURCES)

# Clean build artifacts
clean:
	rm -f $(TARGET)

.PHONY: all clean
