{
	"targets": [
		{
			"target_name": "addon",
			"sources": [
				"src/addon.c",
				"src/main.c"
			],
			"include_dirs": [
				"include"
			],
			"defines": [
				"NAPI_DISABLE_CPP_EXCEPTIONS"
			],
			"cflags_cc": [
				"-Wall",
				"-Wextra",
				"-Wno-unused-parameter"
			],
			"cflags": [
				"-Wall",
				"-Wextra", 
				"-Wno-unused-parameter"
			],
			"conditions": [
				["OS=='win'", {
					"defines": [
						"_HAS_EXCEPTIONS=0"
					]
				}]
			],
			"dependencies": []
		}
	]
}
